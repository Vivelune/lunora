{
  "name": "lunora",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "check:safety": "tsx scripts/check-exam-safety.ts",
    "check:attempts": "tsx scripts/check-attempt-rules.ts",
    "check:order": "tsx scripts/check-attempt-order.ts",
    "check:window": "tsx scripts/check-exam-window.ts",
    "check:focus": "tsx scripts/check-focus-rules.ts",
    "test:attempts": "NODE_OPTIONS=--conditions=react-server tsx scripts/test-attempt-integrity.ts",
    "check:grading": "tsx scripts/check-grading.ts",
    "grade:pending": "NODE_OPTIONS=--conditions=react-server tsx scripts/grade-pending.ts",
    "check:release": "tsx scripts/check-release.ts",
    "check:all": "npm run check:safety && npm run check:window && npm run check:attempts && npm run check:order && npm run check:answers && npm run check:focus && npm run check:grading && npm run check:release",
    "check:answers": "tsx scripts/check-answer-input.ts",
    "check:analytics": "tsx scripts/check-analytics.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@clerk/nextjs": "^7.9.13",
    "@hookform/resolvers": "^5.9.1",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@vercel/blob": "^2.8.1",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "dotenv": "^18.0.6",
    "libphonenumber-js": "^1.13.15",
    "lucide-react": "^1.57.0",
    "next": "16.4.0",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.89.0",
    "react-markdown": "^10.1.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.21.5",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "prisma": "^7.10.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
