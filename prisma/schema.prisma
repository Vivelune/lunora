// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}
enum Role {
  STUDENT
  ADMIN
}

model StudentProfile {
  id                    String    @id @default(cuid())
  clerkUserId           String    @unique
  role                  Role      @default(STUDENT)
  firstName             String?
  lastName              String?
  phone                 String?
  gradeLevel            String?
  onboardingCompletedAt DateTime?
  lessonsCreated        Lesson[]
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

model Subject {
  id          String     @id @default(cuid())
  slug        String     @unique
  name        String
  description String?
  parentId    String?
  parent      Subject?   @relation("SubjectTree", fields: [parentId], references: [id], onDelete: Restrict)
  children    Subject[]  @relation("SubjectTree")
  sortOrder   Int        @default(0)
  isActive    Boolean    @default(true)
  categories  Category[] 
  lessons     Lesson[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([parentId])
}

model Category {
  id          String   @id @default(cuid())
  subjectId   String
  subject     Subject  @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  lessons     Lesson[]
  slug        String
  name        String
  description String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([subjectId, slug])
  @@index([subjectId])
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model Lesson {
  id               String         @id @default(cuid())
  subjectId        String
  subject          Subject        @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  categoryId       String?
  category         Category?      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  title            String
  description      String?
  objectives       String[]
  content          String         @default("")
  estimatedMinutes Int?
  status           ContentStatus  @default(DRAFT)
  publishedAt      DateTime?
  createdById      String
  createdBy        StudentProfile @relation(fields: [createdById], references: [id], onDelete: Restrict)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([subjectId, status])
  @@index([categoryId])
}