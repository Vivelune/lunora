// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}
enum Role {
  STUDENT
  ADMIN
}

model StudentProfile {
  id                    String    @id @default(cuid())
  clerkUserId           String    @unique
  role                  Role      @default(STUDENT)
  firstName             String?
  lastName              String?
  phone                 String?
  gradeLevel            String?
  onboardingCompletedAt DateTime?
  lessonsCreated        Lesson[]
  resourcesUploaded     LearningResource[]
  groupsCreated         StudentGroup[]
  plansCreated          LessonPlan[]
  groupMemberships      StudentGroupMembership[]
  assignmentsReceived   LessonPlanAssignment[] @relation("AssignmentStudent")
  assignmentsCreated    LessonPlanAssignment[] @relation("AssignmentCreator")
  auditLogs             AuditLog[]
  examsCreated          Exam[]
  mediaUploaded MediaAsset[]
    examAssignmentsReceived ExamAssignment[] @relation("ExamAssignmentStudent")
  examAssignmentsCreated  ExamAssignment[] @relation("ExamAssignmentCreator")
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

model Subject {
  id          String     @id @default(cuid())
  slug        String     @unique
  name        String
  description String?
  parentId    String?
  parent      Subject?   @relation("SubjectTree", fields: [parentId], references: [id], onDelete: Restrict)
  children    Subject[]  @relation("SubjectTree")
  sortOrder   Int        @default(0)
  isActive    Boolean    @default(true)
  categories  Category[] 
  lessons     Lesson[]
  lessonPlans LessonPlan[]
  exams       Exam[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([parentId])
}

model Category {
  id          String   @id @default(cuid())
  subjectId   String
  subject     Subject  @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  lessons     Lesson[]
  lessonPlans LessonPlan[]
  exams       Exam[]
  questions   Question[]
  slug        String
  name        String
  description String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([subjectId, slug])
  @@index([subjectId])
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model Lesson {
  id               String         @id @default(cuid())
  subjectId        String
  subject          Subject        @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  categoryId       String?
  category         Category?      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  title            String
  description      String?
  objectives       String[]
  content          String         @default("")
  estimatedMinutes Int?
  status           ContentStatus  @default(DRAFT)
  publishedAt      DateTime?
  createdById      String
  createdBy        StudentProfile @relation(fields: [createdById], references: [id], onDelete: Restrict)
  resources        LearningResource[]
  planItems        LessonPlanItem[]
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([subjectId, status])
  @@index([categoryId])
}

model LearningResource {
  id               String         @id @default(cuid())
  lessonId         String
  lesson           Lesson         @relation(fields: [lessonId], references: [id], onDelete: Restrict)
  title            String
  originalFilename String
  pathname         String         @unique
  storageUrl       String
  contentType      String
  sizeBytes        Int
  uploadedById     String
  uploadedBy       StudentProfile @relation(fields: [uploadedById], references: [id], onDelete: Restrict)
  createdAt        DateTime       @default(now())

  @@index([lessonId])
}

model StudentGroup {
  id          String                   @id @default(cuid())
  name        String                   @unique
  description String?
  isActive    Boolean                  @default(true)
  createdById String
  createdBy   StudentProfile           @relation(fields: [createdById], references: [id], onDelete: Restrict)
  memberships StudentGroupMembership[]
  assignments LessonPlanAssignment[]
  examAssignments ExamAssignment[]
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt
}

model StudentGroupMembership {
  id        String         @id @default(cuid())
  groupId   String
  group     StudentGroup   @relation(fields: [groupId], references: [id], onDelete: Restrict)
  studentId String
  student   StudentProfile @relation(fields: [studentId], references: [id], onDelete: Restrict)
  addedAt   DateTime       @default(now())

  @@unique([groupId, studentId])
  @@index([studentId])
}

enum PlanItemType {
  LESSON
}

model LessonPlan {
  id          String              @id @default(cuid())
  subjectId   String
  subject     Subject             @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  categoryId  String?
  category    Category?           @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  title       String
  description String?
  objectives  String[]
  status      ContentStatus       @default(DRAFT)
  createdById String
  createdBy   StudentProfile      @relation(fields: [createdById], references: [id], onDelete: Restrict)
  versions    LessonPlanVersion[]
  assignments LessonPlanAssignment[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@index([subjectId, status])
}

model LessonPlanVersion {
  id            String           @id @default(cuid())
  planId        String
  plan          LessonPlan       @relation(fields: [planId], references: [id], onDelete: Restrict)
  versionNumber Int
  publishedAt   DateTime?
  items         LessonPlanItem[]
  assignments   LessonPlanAssignment[]
  createdAt     DateTime         @default(now())

  @@unique([planId, versionNumber])
}

model LessonPlanItem {
  id         String            @id @default(cuid())
  versionId  String
  version    LessonPlanVersion @relation(fields: [versionId], references: [id], onDelete: Restrict)
  position   Int
  type       PlanItemType      @default(LESSON)
  lessonId   String?
  lesson     Lesson?           @relation(fields: [lessonId], references: [id], onDelete: Restrict)
  progress   LessonPlanItemProgress[]
  isRequired Boolean           @default(true)

  @@unique([versionId, position])
  @@unique([versionId, lessonId])
  @@index([lessonId])
}

enum AssignmentStatus {
  ACTIVE
  CANCELLED
}

enum Priority {
  LOW
  NORMAL
  HIGH
}

model LessonPlanAssignment {
  id           String            @id @default(cuid())
  planId       String
  plan         LessonPlan        @relation(fields: [planId], references: [id], onDelete: Restrict)
  versionId    String
  version      LessonPlanVersion @relation(fields: [versionId], references: [id], onDelete: Restrict)
  studentId    String
  student      StudentProfile    @relation("AssignmentStudent", fields: [studentId], references: [id], onDelete: Restrict)
  groupId      String?
  group        StudentGroup?     @relation(fields: [groupId], references: [id], onDelete: Restrict)
  assignedAt   DateTime          @default(now())
  startDate    DateTime?
  dueDate      DateTime?
  priority     Priority          @default(NORMAL)
  instructions String?
  status       AssignmentStatus  @default(ACTIVE)
  startedAt    DateTime?
  completedAt  DateTime?
  createdById  String
  createdBy    StudentProfile    @relation("AssignmentCreator", fields: [createdById], references: [id], onDelete: Restrict)
  progress     LessonPlanItemProgress[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@unique([studentId, planId])
  @@index([planId])
  @@index([studentId, status])
  @@index([groupId])
}

model AuditLog {
  id         String         @id @default(cuid())
  actorId    String
  actor      StudentProfile @relation(fields: [actorId], references: [id], onDelete: Restrict)
  action     String
  entityType String
  entityId   String?
  details    Json?
  createdAt  DateTime       @default(now())

  @@index([actorId])
  @@index([entityType, entityId])
  @@index([createdAt])
}

model LessonPlanItemProgress {
  id           String               @id @default(cuid())
  assignmentId String
  assignment   LessonPlanAssignment @relation(fields: [assignmentId], references: [id], onDelete: Restrict)
  itemId       String
  item         LessonPlanItem       @relation(fields: [itemId], references: [id], onDelete: Restrict)
  completedAt  DateTime             @default(now())

  @@unique([assignmentId, itemId])
  @@index([itemId])
}

enum ReleasePolicy {
  IMMEDIATE
  AFTER_DEADLINE
  MANUAL
}

enum FocusPolicy {
  OFF
  LOG_ONLY
  WARN_THEN_FLAG
  AUTO_SUBMIT
}

model Exam {
  id             String        @id @default(cuid())
  subjectId      String
  subject        Subject       @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  categoryId     String?
  category       Category?     @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  title          String
  description    String?
  status         ContentStatus @default(DRAFT)
  availableFrom  DateTime?
  availableUntil DateTime?
  createdById    String
  createdBy      StudentProfile @relation(fields: [createdById], references: [id], onDelete: Restrict)
  versions       ExamVersion[]
  visibility     ExamVisibility @default(ASSIGNED_ONLY)
  assignments    ExamAssignment[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([subjectId, status])
}

model ExamVersion {
  id                 String        @id @default(cuid())
  examId             String
  exam               Exam          @relation(fields: [examId], references: [id], onDelete: Restrict)
  versionNumber      Int
  publishedAt        DateTime?
  instructions       String?
  durationMinutes    Int           @default(60)
  maxAttempts        Int           @default(1)
  passingPercent     Int?
  shuffleQuestions   Boolean       @default(false)
  shuffleOptions     Boolean       @default(false)
  resultRelease      ReleasePolicy @default(IMMEDIATE)
  explanationRelease ReleasePolicy @default(AFTER_DEADLINE)
  focusPolicy        FocusPolicy   @default(OFF)
  maxFocusViolations Int           @default(3)
  requireFullscreen  Boolean       @default(false)
  questions          Question[]
  assignments        ExamAssignment[]
  createdAt          DateTime      @default(now())

  @@unique([examId, versionNumber])
}

enum QuestionType {
  SINGLE_CHOICE
  MULTIPLE_SELECT
  TRUE_FALSE
  SHORT_ANSWER
}

model Question {
  id              String         @id @default(cuid())
  versionId       String
  version         ExamVersion    @relation(fields: [versionId], references: [id], onDelete: Restrict)
  position        Int
  type            QuestionType
  prompt          String
  points          Decimal        @db.Decimal(6, 2)
  explanation     String?
  categoryId      String?
  category        Category?      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  imageId         String?
  image           MediaAsset?    @relation(fields: [imageId], references: [id], onDelete: Restrict)
  imageAlt        String?
  acceptedAnswers String[]
  options         AnswerOption[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@unique([versionId, position])
  @@index([categoryId])
  @@index([imageId])
}

model AnswerOption {
  id         String   @id @default(cuid())
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Restrict)
  position   Int
  text       String
  isCorrect  Boolean

  @@unique([questionId, position])
}

model MediaAsset {
  id           String         @id @default(cuid())
  pathname     String         @unique
  storageUrl   String
  contentType  String
  sizeBytes    Int
  uploadedById String
  uploadedBy   StudentProfile @relation(fields: [uploadedById], references: [id], onDelete: Restrict)
  questions    Question[]
  createdAt    DateTime       @default(now())
}

enum ExamVisibility {
  ASSIGNED_ONLY
  OPEN_PRACTICE
}

model ExamAssignment {
  id                  String           @id @default(cuid())
  examId              String
  exam                Exam             @relation(fields: [examId], references: [id], onDelete: Restrict)
  versionId           String
  version             ExamVersion      @relation(fields: [versionId], references: [id], onDelete: Restrict)
  studentId           String
  student             StudentProfile   @relation("ExamAssignmentStudent", fields: [studentId], references: [id], onDelete: Restrict)
  groupId             String?
  group               StudentGroup?    @relation(fields: [groupId], references: [id], onDelete: Restrict)
  assignedAt          DateTime         @default(now())
  availableFrom       DateTime?
  dueDate             DateTime?
  maxAttemptsOverride Int?
  instructions        String?
  status              AssignmentStatus @default(ACTIVE)
  createdById         String
  createdBy           StudentProfile   @relation("ExamAssignmentCreator", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  @@unique([studentId, examId])
  @@index([examId])
  @@index([studentId, status])
  @@index([groupId])
}