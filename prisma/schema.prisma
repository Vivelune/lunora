// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}
enum Role {
  STUDENT
  ADMIN
}

model StudentProfile {
  id                    String    @id @default(cuid())
  clerkUserId           String    @unique
  role                  Role      @default(STUDENT)
  firstName             String?
  lastName              String?
  phone                 String?
  gradeLevel            String?
  onboardingCompletedAt DateTime?
  lessonsCreated        Lesson[]
  resourcesUploaded     LearningResource[]
  groupsCreated         StudentGroup[]
  plansCreated          LessonPlan[]
  groupMemberships      StudentGroupMembership[]
  assignmentsReceived   LessonPlanAssignment[] @relation("AssignmentStudent")
  assignmentsCreated    LessonPlanAssignment[] @relation("AssignmentCreator")
  auditLogs             AuditLog[]
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

model Subject {
  id          String     @id @default(cuid())
  slug        String     @unique
  name        String
  description String?
  parentId    String?
  parent      Subject?   @relation("SubjectTree", fields: [parentId], references: [id], onDelete: Restrict)
  children    Subject[]  @relation("SubjectTree")
  sortOrder   Int        @default(0)
  isActive    Boolean    @default(true)
  categories  Category[] 
  lessons     Lesson[]
  lessonPlans LessonPlan[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([parentId])
}

model Category {
  id          String   @id @default(cuid())
  subjectId   String
  subject     Subject  @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  lessons     Lesson[]
  lessonPlans LessonPlan[]
  slug        String
  name        String
  description String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([subjectId, slug])
  @@index([subjectId])
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model Lesson {
  id               String         @id @default(cuid())
  subjectId        String
  subject          Subject        @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  categoryId       String?
  category         Category?      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  title            String
  description      String?
  objectives       String[]
  content          String         @default("")
  estimatedMinutes Int?
  status           ContentStatus  @default(DRAFT)
  publishedAt      DateTime?
  createdById      String
  createdBy        StudentProfile @relation(fields: [createdById], references: [id], onDelete: Restrict)
  resources        LearningResource[]
  planItems        LessonPlanItem[]
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([subjectId, status])
  @@index([categoryId])
}

model LearningResource {
  id               String         @id @default(cuid())
  lessonId         String
  lesson           Lesson         @relation(fields: [lessonId], references: [id], onDelete: Restrict)
  title            String
  originalFilename String
  pathname         String         @unique
  storageUrl       String
  contentType      String
  sizeBytes        Int
  uploadedById     String
  uploadedBy       StudentProfile @relation(fields: [uploadedById], references: [id], onDelete: Restrict)
  createdAt        DateTime       @default(now())

  @@index([lessonId])
}

model StudentGroup {
  id          String                   @id @default(cuid())
  name        String                   @unique
  description String?
  isActive    Boolean                  @default(true)
  createdById String
  createdBy   StudentProfile           @relation(fields: [createdById], references: [id], onDelete: Restrict)
  memberships StudentGroupMembership[]
  assignments LessonPlanAssignment[]
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt
}

model StudentGroupMembership {
  id        String         @id @default(cuid())
  groupId   String
  group     StudentGroup   @relation(fields: [groupId], references: [id], onDelete: Restrict)
  studentId String
  student   StudentProfile @relation(fields: [studentId], references: [id], onDelete: Restrict)
  addedAt   DateTime       @default(now())

  @@unique([groupId, studentId])
  @@index([studentId])
}

enum PlanItemType {
  LESSON
}

model LessonPlan {
  id          String              @id @default(cuid())
  subjectId   String
  subject     Subject             @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  categoryId  String?
  category    Category?           @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  title       String
  description String?
  objectives  String[]
  status      ContentStatus       @default(DRAFT)
  createdById String
  createdBy   StudentProfile      @relation(fields: [createdById], references: [id], onDelete: Restrict)
  versions    LessonPlanVersion[]
  assignments LessonPlanAssignment[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@index([subjectId, status])
}

model LessonPlanVersion {
  id            String           @id @default(cuid())
  planId        String
  plan          LessonPlan       @relation(fields: [planId], references: [id], onDelete: Restrict)
  versionNumber Int
  publishedAt   DateTime?
  items         LessonPlanItem[]
  assignments   LessonPlanAssignment[]
  createdAt     DateTime         @default(now())

  @@unique([planId, versionNumber])
}

model LessonPlanItem {
  id         String            @id @default(cuid())
  versionId  String
  version    LessonPlanVersion @relation(fields: [versionId], references: [id], onDelete: Restrict)
  position   Int
  type       PlanItemType      @default(LESSON)
  lessonId   String?
  lesson     Lesson?           @relation(fields: [lessonId], references: [id], onDelete: Restrict)
  isRequired Boolean           @default(true)

  @@unique([versionId, position])
  @@unique([versionId, lessonId])
  @@index([lessonId])
}

enum AssignmentStatus {
  ACTIVE
  CANCELLED
}

enum Priority {
  LOW
  NORMAL
  HIGH
}

model LessonPlanAssignment {
  id           String            @id @default(cuid())
  planId       String
  plan         LessonPlan        @relation(fields: [planId], references: [id], onDelete: Restrict)
  versionId    String
  version      LessonPlanVersion @relation(fields: [versionId], references: [id], onDelete: Restrict)
  studentId    String
  student      StudentProfile    @relation("AssignmentStudent", fields: [studentId], references: [id], onDelete: Restrict)
  groupId      String?
  group        StudentGroup?     @relation(fields: [groupId], references: [id], onDelete: Restrict)
  assignedAt   DateTime          @default(now())
  startDate    DateTime?
  dueDate      DateTime?
  priority     Priority          @default(NORMAL)
  instructions String?
  status       AssignmentStatus  @default(ACTIVE)
  startedAt    DateTime?
  completedAt  DateTime?
  createdById  String
  createdBy    StudentProfile    @relation("AssignmentCreator", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@unique([studentId, planId])
  @@index([planId])
  @@index([studentId, status])
  @@index([groupId])
}

model AuditLog {
  id         String         @id @default(cuid())
  actorId    String
  actor      StudentProfile @relation(fields: [actorId], references: [id], onDelete: Restrict)
  action     String
  entityType String
  entityId   String?
  details    Json?
  createdAt  DateTime       @default(now())

  @@index([actorId])
  @@index([entityType, entityId])
  @@index([createdAt])
}